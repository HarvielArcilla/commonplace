{
  "name": "commonplace",
  "private": true,
  "version": "0.3.0",
  "description": "A free, open-source collaborative office suite (docs, sheets, slides, tasks, calendars, whiteboards, forms and a shared drive) with no server and no account.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @commonplace/desktop",
    "build": "npm run build -w @commonplace/desktop",
    "dist": "npm run dist -w @commonplace/desktop",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "compat": "node scripts/compat.mjs",
    "start": "npm run dev -w @commonplace/desktop",
    "relay": "node packages/relay/bin/commonplace-relay.js",
    "server": "node packages/server/bin/commonplace-server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarvielArcilla/commonplace.git"
  }
}
