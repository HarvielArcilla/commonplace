{
  "name": "@commonplace/desktop",
  "productName": "commonplace",
  "version": "0.1.0",
  "description": "The commonplace suite, peer-to-peer, no servers.",
  "author": "Harviel Arcilla",
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win",
    "postinstall": "node scripts/brand.mjs"
  },
  "dependencies": {
    "@commonplace/core": "0.1.0",
    "@commonplace/docs": "0.1.0",
    "@commonplace/drive": "0.1.0",
    "@commonplace/sheets": "0.1.0",
    "@commonplace/slides": "0.1.0",
    "@commonplace/tasks": "0.1.0",
    "@commonplace/calendar": "0.1.0",
    "@commonplace/whiteboard": "0.1.0",
    "@commonplace/forms": "0.1.0",
    "hyperdht": "^6.34.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "org.commonplace.desktop",
    "productName": "commonplace",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/icon.png",
      "src/**",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/dist/**",
      "!renderer/dist/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "commonplace invite",
        "schemes": [
          "commonplace"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "commonplace"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HarvielArcilla/commonplace.git"
  }
}
